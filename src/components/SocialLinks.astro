---
import { social } from '../data/nav';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['social-links', className]}>
  <a href={social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
    </svg>
  </a>
  <a href={social.twitter} target="_blank" rel="noopener" aria-label="X (Twitter)">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93zm-1.29 19.5h2.04L6.48 3.24H4.29L17.61 20.65z"/>
    </svg>
  </a>
  <a href={social.github} target="_blank" rel="noopener" aria-label="GitHub">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.28 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/>
    </svg>
  </a>
  <a href={social.bluesky} target="_blank" rel="noopener" aria-label="Bluesky">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M12 10.8C10.9 8.6 7.9 4.6 5.1 2.6 2.4.7 1.4 1 .7 1.3.1 1.6 0 2.6 0 3.2c0 .6.3 4.9.5 5.6.7 2.4 3.2 3.2 5.5 3-3.4.5-6.4 1.7-2.4 6.2 4.3 4.6 5.9-1 6.4-3.7.5 2.7 1.4 8.1 5.9 3.7 3.7-3.7 1-5.7-2.4-6.2 2.3.2 4.8-.6 5.5-3 .2-.7.5-5 .5-5.6 0-.6-.1-1.6-.7-1.9-.7-.3-1.7-.6-4.4 1.3-2.8 2-5.8 6-6.9 8.2z"/>
    </svg>
  </a>
</div>

<style>
  .social-links {
    display: flex;
    gap: 0.6rem;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transition: transform var(--transition), background var(--transition), color var(--transition);
  }
  .social-links a:hover {
    background: var(--color-accent);
    color: #fff;
    transform: translateY(-3px);
  }
</style>
