---
import { navItems, contact } from '../data/nav';
import SocialLinks from './SocialLinks.astro';
import { withBase } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src={withBase('/images/logo.png')} alt="Freddy.dk" class="footer-logo" width="1059" height="322" />
      <p>
        Experienced technology leader bridging strategy, innovation, and
        architecture with a sharp focus on customer value and team success.
      </p>
      <SocialLinks />
    </div>

    <div class="footer-links">
      <h4>Quick links</h4>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.external ? item.href : withBase(item.href)} {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-contact">
      <h4>Get in touch</h4>
      <ul>
        <li>{contact.name}</li>
        <li>{contact.address}</li>
        <li><a href={`tel:${contact.phoneHref}`}>{contact.phone}</a></li>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} Freddy Kristiansen. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: #b9bfe0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr;
    gap: 3rem;
    padding-block: 4rem 3rem;
  }
  .footer-logo {
    height: 42px;
    width: auto;
    margin-bottom: 1.25rem;
    background: #fff;
    padding: 8px 12px;
    border-radius: 10px;
  }
  .footer-brand p {
    max-width: 34ch;
    color: #b9bfe0;
    font-size: 0.98rem;
  }
  .site-footer h4 {
    color: #fff;
    font-size: 1.05rem;
    margin-bottom: 1.1rem;
  }
  .footer-links ul,
  .footer-contact ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-links li,
  .footer-contact li {
    margin-bottom: 0.6rem;
    font-size: 0.98rem;
  }
  .site-footer a {
    color: #b9bfe0;
  }
  .site-footer a:hover { color: #fff; }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 1.4rem;
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.9rem;
    color: #8a90b8;
    text-align: center;
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
