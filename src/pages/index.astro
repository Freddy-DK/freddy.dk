---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/url';

const services = [
  {
    title: 'Freddy in Your Corner',
    href: '/freddy-in-your-corner/',
    image: '/images/freddy-in-your-corner.png',
    text: 'Drawing on 23+ years at Microsoft and decades in engineering leadership, product strategy, and developer advocacy - an experienced voice in the room for architecture design, DevOps challenges, and customer solutions. Trust, clarity, confidence, and impact.',
  },
  {
    title: 'Motivational Speaker',
    href: '/motivational-speaker/',
    image: '/images/motivational-speaker.png',
    text: 'Inspiring audiences to unlock their full potential, embrace change, and take meaningful action. High-impact talks that combine storytelling, practical insight, and emotional connection - leaving audiences energized, focused, and ready to move forward with purpose.',
  },
  {
    title: 'DevOps / AL-Go / Fkh',
    href: '/devops/',
    image: '/images/devops.png',
    text: 'DevOps is essential for modern development teams. Health checks for GitHub, Azure DevOps, or transition planning. A well-prepared DevOps strategy ensures stability and security while helping you stay competitive and deliver consistent value to your customers.',
  },
];

const reasons = [
  'Expert-level input on demand: fast, honest, and actionable',
  'Clear guidance aligning business goals with technical decisions',
  'Strengthen customer offerings by bringing expertise into the room',
  'Confidence, clarity, and momentum in every critical phase',
];
---

<Layout title="Freddy.DK - Home">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Technology leadership &amp; advisory</span>
        <h1>
          Bridging strategy, innovation, and architecture - with a sharp focus
          on <span class="grad">customer value</span> and team success.
        </h1>
        <p class="lead">
          Think of me as your tech-savvy co-pilot - here to cut through
          complexity, boost momentum, and light a fire under teams when they
          need it most.
        </p>
        <div class="hero-actions">
          <a href={withBase('/freddy-in-your-corner/')} class="btn btn--primary">Explore my services</a>
          <a href={withBase('/contact/')} class="btn btn--outline">Get in touch</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="blob"></div>
        <img src={withBase('/images/freddy-in-your-corner.png')} alt="" width="1024" height="1024" />
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">My services</span>
        <h2>How I can help</h2>
        <p class="lead">
          Three ways to put decades of hands-on experience to work for your
          team and your customers.
        </p>
      </div>

      <div class="service-grid">
        {services.map((s) => (
          <a href={withBase(s.href)} class="service-card">
            <div class="service-card__img">
              <img src={withBase(s.image)} alt={s.title} width="1024" height="1024" loading="lazy" />
            </div>
            <div class="service-card__body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="service-card__link">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why choose me -->
  <section class="section section--lavender">
    <div class="container why-grid">
      <div class="why-copy">
        <span class="eyebrow">Why choose me</span>
        <h2>
          You don’t need to hire a full-time CTO or staff a team of specialists.
        </h2>
        <p class="lead">
          You just need someone who’s seen it, built it, and solved it before -
          ready to step in exactly when it matters.
        </p>
      </div>
      <ul class="why-list">
        {reasons.map((r) => (
          <li>
            <span class="check" aria-hidden="true">✓</span>
            {r}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <div class="container text-center">
      <h2>Let’s build something that lasts.</h2>
      <p>
        Bring me into your corner for the critical phases - architecture,
        DevOps, or the spark your team needs.
      </p>
      <a href={withBase('/contact/')} class="btn btn--primary">Contact me for more information</a>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(1000px 500px at 85% -10%, rgba(142, 99, 255, 0.14), transparent 60%),
      linear-gradient(180deg, #fbfbff, #ffffff);
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 3rem;
  }
  .hero-copy h1 { margin-bottom: 1rem; }
  .grad {
    background: linear-gradient(120deg, var(--color-accent), var(--color-purple));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-copy .lead { margin-bottom: 2rem; max-width: 46ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; }

  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
  }
  .hero-art img {
    position: relative;
    width: min(360px, 80%);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .hero-art .blob {
    position: absolute;
    inset: 10% 4% 0 12%;
    background: linear-gradient(135deg, var(--color-accent), var(--color-purple));
    filter: blur(10px);
    opacity: 0.35;
    border-radius: 40% 60% 55% 45% / 45% 45% 55% 55%;
    animation: float 8s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-14px) rotate(4deg); }
  }

  /* Services */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }
  .service-card__img {
    aspect-ratio: 16 / 10;
    background: var(--color-purple);
    overflow: hidden;
  }
  .service-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .service-card:hover .service-card__img img { transform: scale(1.05); }
  .service-card__body {
    padding: 1.6rem 1.6rem 1.8rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .service-card__body h3 { color: var(--color-navy); }
  .service-card__body p { font-size: 0.98rem; color: var(--color-text-muted); }
  .service-card__link {
    margin-top: auto;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Why */
  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .why-copy .lead { margin-bottom: 0; }
  .why-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .why-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    font-weight: 500;
    color: var(--color-navy);
    box-shadow: var(--shadow-sm);
  }
  .check {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent), var(--color-purple));
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* Homepage CTA reuse */
  .cta-band {
    background: linear-gradient(135deg, var(--color-purple), var(--color-accent));
    color: #fff;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cta-band h2 { color: #fff; margin-bottom: 0.6rem; }
  .cta-band p { max-width: 52ch; margin: 0 auto 1.8rem; color: rgba(255,255,255,0.9); font-size: 1.1rem; }
  .cta-band .btn--primary { background: #fff; color: var(--color-purple); box-shadow: 0 10px 24px rgba(0,0,0,0.18); }
  .cta-band .btn--primary:hover { color: var(--color-purple); }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-art { order: -1; }
    .service-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
    .why-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
