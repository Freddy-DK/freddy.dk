---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { contact } from '../data/nav';
---

<Layout
  title="Freddy.DK - Contact me"
  description="Get in touch with Freddy Kristiansen - email contact@freddy.dk, call +45 5352 0103, or reach out on LinkedIn, X, GitHub, or Bluesky."
>
  <PageHero
    eyebrow="Let’s talk"
    title="Contact me"
    lead="I would love to hear from you. Feel free to reach out directly by email or phone."
  />

  <section class="section">
    <div class="container container--narrow">
      <!-- Primary actions: email + phone -->
      <div class="contact-actions">
        <a href={`mailto:${contact.email}`} class="contact-action">
          <span class="contact-action__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m2 7 10 6 10-6" />
            </svg>
          </span>
          <span class="contact-action__label">Email me</span>
          <span class="contact-action__value">{contact.email}</span>
        </a>

        <a href={`tel:${contact.phoneHref}`} class="contact-action">
          <span class="contact-action__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </span>
          <span class="contact-action__label">Call me</span>
          <span class="contact-action__value">{contact.phone}</span>
        </a>
      </div>

      <!-- Secondary details -->
      <div class="contact-extra">
        <div class="contact-extra__item">
          <span class="detail-label">Based in</span>
          <p>{contact.address}</p>
        </div>
        <div class="contact-extra__item">
          <span class="detail-label">Find me online</span>
          <SocialLinks class="social-light" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Primary email / phone cards */
  .contact-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .contact-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .contact-action:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
    color: inherit;
  }
  .contact-action__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    margin-bottom: 0.75rem;
    background: linear-gradient(135deg, var(--color-accent), var(--color-purple));
    color: #fff;
  }
  .contact-action__label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .contact-action__value {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-navy);
    word-break: break-word;
  }

  /* Secondary details */
  .contact-extra {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }
  .detail-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .contact-extra__item p { margin: 0; color: var(--color-navy); font-weight: 500; }

  /* Recolor the shared social component for the light background */
  .contact-extra :global(.social-links a) {
    background: var(--color-lavender);
    color: var(--color-navy);
  }
  .contact-extra :global(.social-links a:hover) {
    background: var(--color-accent);
    color: #fff;
  }

  @media (max-width: 640px) {
    .contact-actions { grid-template-columns: 1fr; }
    .contact-extra {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      align-items: start;
    }
  }
</style>
