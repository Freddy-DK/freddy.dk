---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { contact } from '../data/nav';
import { withBase } from '../utils/url';

const details = [
  { label: 'Name', value: contact.name },
  { label: 'Address', value: contact.address },
  { label: 'Phone', value: contact.phone, href: `tel:${contact.phoneHref}` },
  { label: 'Email', value: contact.email, href: `mailto:${contact.email}` },
];
---

<Layout
  title="Freddy.DK — Contact me"
  description="Get in touch with Freddy Kristiansen — email contact@freddy.dk or reach out on LinkedIn, X, GitHub, or Bluesky."
>
  <PageHero
    eyebrow="Let’s talk"
    title="Contact me"
    lead="I would love to hear from you. Feel free to reach out using the details below."
  />

  <section class="section">
    <div class="container contact-grid">
      <!-- Details -->
      <div class="contact-info">
        <span class="eyebrow">Contact details</span>
        <h2>Reach out directly</h2>
        <ul class="detail-list">
          {details.map((d) => (
            <li>
              <span class="detail-label">{d.label}</span>
              {d.href
                ? <a href={d.href} class="detail-value">{d.value}</a>
                : <span class="detail-value">{d.value}</span>}
            </li>
          ))}
        </ul>

        <div class="contact-social">
          <span class="detail-label">Find me online</span>
          <SocialLinks class="social-dark" />
        </div>
      </div>

      <!-- Form -->
      <div class="contact-form-wrap">
        <h3>Send a message</h3>
        <!--
          This form is wired for Netlify Forms (works automatically when deployed to Netlify).
          For other hosts, set `action` to a Formspree endpoint (https://formspree.io) or your
          own handler, and remove the data-netlify attributes.
        -->
        <form
          name="contact"
          method="POST"
          action={`${withBase('/contact/')}?sent=1`}
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hp"><label>Don’t fill this out: <input name="bot-field" /></label></p>

          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="subject">Subject</label>
            <input id="subject" name="subject" type="text" />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn--primary">Send message</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3.5rem;
    align-items: start;
  }

  .detail-list { list-style: none; margin: 1.5rem 0 2rem; padding: 0; display: grid; gap: 1.1rem; }
  .detail-list li { display: flex; flex-direction: column; }
  .detail-label {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.15rem;
  }
  .detail-value { font-size: 1.1rem; color: var(--color-navy); font-weight: 500; }
  a.detail-value:hover { color: var(--color-accent); }

  .contact-social { display: flex; flex-direction: column; gap: 0.7rem; }
  /* Recolor the shared social component for the light background */
  .contact-social :global(.social-links a) {
    background: var(--color-lavender);
    color: var(--color-navy);
  }
  .contact-social :global(.social-links a:hover) {
    background: var(--color-accent);
    color: #fff;
  }

  .contact-form-wrap {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-md);
  }
  .contact-form-wrap h3 { color: var(--color-navy); margin-bottom: 1.25rem; }
  .contact-form { display: grid; gap: 1.1rem; }
  .field { display: grid; gap: 0.4rem; }
  .field label {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--color-navy);
  }
  .field input,
  .field textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: #fbfbff;
    color: var(--color-text);
    transition: border-color var(--transition), box-shadow var(--transition);
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(142, 99, 255, 0.15);
  }
  .contact-form .btn { justify-self: start; }
  .hp { position: absolute; left: -9999px; }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
