---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { withBase } from '../utils/url';

const support = [
  'Architecture design & technical reviews',
  'Product / platform strategy',
  'Executive sparring & roadmap validation',
  'DevOps pipeline assessment & optimization',
  'Hands-on troubleshooting in critical moments',
];

const engagements = [
  {
    title: 'Fractional CTO',
    text: 'High-level technical leadership during critical phases — without the commitment of a full-time hire.',
  },
  {
    title: 'Trusted advisor',
    text: 'A sounding board for your toughest architecture and product decisions, available when you need it.',
  },
  {
    title: 'Technical partner',
    text: 'Hands-on support that plugs directly into your team to move things forward, virtually or on-site.',
  },
];
---

<Layout
  title="Freddy.DK — Freddy in Your Corner"
  description="Bring Freddy into your corner as a fractional CTO, trusted advisor, or high-level technical partner during your most critical phases."
>
  <PageHero
    eyebrow="Advisory & fractional CTO"
    title="Freddy in Your Corner"
    lead="Whether you need a fractional CTO, a trusted advisor, or a high-level technical partner during critical phases, you can bring me into your corner."
  />

  <section class="section">
    <div class="container container--narrow">
      <p class="lead">
        When you’re building something complex, the difference between success
        and stalled momentum often comes down to having the right person in the
        room.
      </p>
    </div>
  </section>

  <section class="section section--lavender">
    <div class="container split">
      <div>
        <span class="eyebrow">Ways I support you</span>
        <h2>The value I bring</h2>
        <p>
          You can engage me on a flexible basis through retainers, hourly
          blocks, or project-specific engagements — virtually or on-site.
        </p>
        <a href={withBase('/contact/')} class="btn btn--outline">Contact me for more information</a>
      </div>
      <ul class="feature-list">
        {support.map((s) => (
          <li><span class="dot" aria-hidden="true"></span>{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Examples of engagements</span>
        <h2>How we can work together</h2>
      </div>
      <div class="card-grid">
        {engagements.map((e) => (
          <div class="info-card">
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Need an experienced voice in the room?"
    text="Let’s talk about where you are, where you’re heading, and how I can help you get there."
  />
</Layout>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .feature-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .feature-list li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    font-weight: 500;
    color: var(--color-navy);
    box-shadow: var(--shadow-sm);
  }
  .dot {
    flex-shrink: 0;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent), var(--color-purple));
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .info-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 1.8rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .info-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
  .info-card h3 { color: var(--color-navy); }
  .info-card p { color: var(--color-text-muted); margin-bottom: 0; }

  @media (max-width: 820px) {
    .split { grid-template-columns: 1fr; gap: 2rem; }
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
